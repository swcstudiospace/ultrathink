# DRAFT, NOT INSTALLED, AND NOT INSTALLABLE YET. Do not copy into /etc/systemd/system.
# ExecStart points at services/ultrathink/worker/main.ts, which does not exist: worker/ holds only mirror.ts and worker.ts
# (library code, no entrypoint and no signal handling). Server-side planning runs inside ultrathink-web (engine/headless.ts),
# so no separate worker process is needed today. Before enabling this unit, add the entrypoint and then harden the unit
# like ultrathink-web.service (dedicated user, /opt release, sandbox directives).
# Rollback: systemctl disable --now ultrathink-worker

[Unit]
Description=Ultrathink planning worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/src/repos/claude-ultrathink
EnvironmentFile=/etc/ultrathink/ultrathink.env
ExecStart=/root/.local/share/reflex/bun/bin/bun run services/ultrathink/worker/main.ts
Restart=on-failure
RestartSec=3
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ultrathink-worker

[Install]
WantedBy=multi-user.target
