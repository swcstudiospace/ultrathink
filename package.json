{
	"name": "ultrathink",
	"version": "1.4.0",
	"private": true,
	"type": "module",
	"description": "Plans every prompt into a spec + Graph of Thought, tracks it in Linear/Notion, and ships finished work through a Greptile-gated PR, across Claude Code, Grok Build, Hermes Agent, Muse, Omp, Prime Agent and Cursor.",
	"license": "AGPL-3.0-or-later",
	"author": "SWC Studio",
	"homepage": "https://github.com/swcstudiospace/claude-ultrathink#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/swcstudiospace/claude-ultrathink.git"
	},
	"bugs": {
		"url": "https://github.com/swcstudiospace/claude-ultrathink/issues"
	},
	"keywords": ["claude-code", "grok", "hermes", "muse", "omp", "prime-agent", "cursor", "agent", "planning", "graph-of-thought", "linear", "notion", "greptile"],
	"engines": {
		"bun": ">=1.2"
	},
	"scripts": {
		"test": "bun test",
		"check": "bunx --package typescript@5.9.3 tsc --noEmit",
		"check:services": "bunx --package typescript@5.9.3 tsc --noEmit -p services/ultrathink/tsconfig.json",
		"lint": "biome check --error-on-warnings .",
		"format": "biome format --write .",
		"deadcode": "knip --include exports,types",
		"verify": "bun run check && bun run lint && bun run deadcode && bun test && python3 hosts/hermes/bridge_test.py && python3 hosts/prime-agent/bridge_test.py",
		"hook:uplift": "bun hooks/uplift.ts",
		"uplift": "bun hooks/uplift.ts --ctl",
		"setup": "bun scripts/setup.ts",
		"mcp": "bun src/mcp/cli.ts",
		"chaos": "bun services/ultrathink/chaos/cli.ts",
		"ship": "bun src/ship/cli.ts",
		"policy:check": "bash policy/check.sh",
		"policy:collect": "bun policy/collect.ts",
		"compliance": "bun policy/compliance-report.ts --root ."
	},
	"omp": {
		"extensions": ["./src/host/omp.ts"]
	},
	"pi": {
		"extensions": ["./src/host/omp.ts"]
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@oh-my-pi/pi-ai": "^18.12.1",
		"@oh-my-pi/pi-catalog": "^18.12.1",
		"@types/bun": "^1.4.3",
		"knip": "6.43.0",
		"yaml": "2.9.1"
	}
}
