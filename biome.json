{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**/*.ts", "!plugins", "!hosts", "!.semgrep"] },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"bracketSpacing": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": { "noCommaOperator": "off", "useOptionalChain": "off" },
			"correctness": { "noUnsafeOptionalChaining": "off" },
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"noConfusingVoidType": "off",
				"noControlCharactersInRegex": "off",
				"noPrototypeBuiltins": "off",
				"noTemplateCurlyInString": "off"
			},
			"style": { "noNonNullAssertion": "off" }
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "off" } } }
}
