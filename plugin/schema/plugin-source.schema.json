{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin-source.schema.json",
  "title": "ultrathink plugin source",
  "description": "Source of truth for generated host plugin manifests (plugin/source/plugin.source.yaml). A host with status unmapped produces no output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "license", "author", "hosts"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude-code": { "$ref": "#/$defs/host" },
        "muse": { "$ref": "#/$defs/host" },
        "omp": { "$ref": "#/$defs/host" },
        "hermes": { "$ref": "#/$defs/host" },
        "prime-agent": { "$ref": "#/$defs/host" },
        "grok-build": { "$ref": "#/$defs/host" }
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "status"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["verified", "unmapped"] }
      }
    }
  }
}
