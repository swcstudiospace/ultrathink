# Placeholders only: this file is a template, not a configuration. Copy the lines you need into your
# own environment file, replace each <your-...> value with the real one, and delete the lines you do
# not use. A line left as a placeholder is a wrong value, and `ultrathink doctor` reports it.
# Secrets are commented out here; set them in the credential store (bin/ultrathink-mcp auth set-key)
# or in your own private environment, never in a file that is committed.
# Every variable is described in docs/environment.md.

# Set to 0 to plan no prompt in this process.
ULTRATHINK_UPLIFT=<your-uplift>

# Set to 0 so the planner creates no tracker rows in this process.
ULTRATHINK_TRACK=<your-track>

# Set to 0 for no ship instruction in the plan and no ship nudge, even with ship.enabled.
ULTRATHINK_SHIP=<your-ship>

# Set to 0 to turn every Jev decision point off for this process, whatever the config says.
ULTRATHINK_DECISIONS=<your-decisions>

# Set to 0 to send no Hindsight request in this process, even with hindsight.enabled.
ULTRATHINK_HINDSIGHT=<your-hindsight>

# Set to 0 to send no RAGFlow request in this process; whitespace around the 0 is trimmed.
ULTRATHINK_RAGFLOW=<your-ragflow>

# Set to 0 to turn Teachable Moments off for this process (no capture, recall or promote).
ULTRATHINK_TEACH=<your-teach>

# Set to 0 to force Hindsight, RAGFlow and the Substrate brief back to their direct backends.
ULTRATHINK_GATEWAY=<your-gateway>

# Set to 0 so the Cursor pstack hook injects nothing for this process.
ULTRATHINK_PSTACK=<your-pstack>

# Set to 1 to never contact Agent Substrate, even when SUBSTRATE_URL or substrate.url is set.
SUBSTRATE_DISABLED=<your-substrate-disabled>

# Set to off to skip the Realm probe; any other value leaves it on.
ULTRATHINK_REALM=<your-realm>

# Chooses the Hindsight backend and wins over hindsight.backend unless ULTRATHINK_GATEWAY is 0.
ULTRATHINK_HINDSIGHT_BACKEND=<your-hindsight-backend>

# Chooses the RAGFlow backend and wins over ragflow.backend unless ULTRATHINK_GATEWAY is 0.
ULTRATHINK_RAGFLOW_BACKEND=<your-ragflow-backend>

# Chooses the Substrate brief backend and wins over substrate.backend unless ULTRATHINK_GATEWAY is 0.
ULTRATHINK_SUBSTRATE_BACKEND=<your-substrate-backend>

# Agent Substrate base URL.
SUBSTRATE_URL=<your-substrate-url>

# Bearer sent to Agent Substrate.
# SUBSTRATE_TOKEN=<your-substrate-token>

# File whose first line is the bearer when SUBSTRATE_TOKEN is empty.
SUBSTRATE_TOKEN_FILE=<your-substrate-token-file>

# Directory of per-surface bearer files, read as DIR/SURFACE when neither SUBSTRATE_TOKEN nor SUBSTRATE_TOKEN_FILE gives one.
SUBSTRATE_TOKENS_DIR=<your-substrate-tokens-dir>

# Timeout of one Agent Substrate request in milliseconds.
SUBSTRATE_TIMEOUT_MS=<your-substrate-timeout-ms>

# Hindsight base URL, used only when hindsight.url is empty.
HINDSIGHT_API_URL=<your-hindsight-api-url>

# Alias of HINDSIGHT_API_URL, read only when HINDSIGHT_API_URL is empty.
HINDSIGHT_URL=<your-hindsight-url>

# Hindsight API key, used when no hindsight key is stored.
# HINDSIGHT_API_KEY=<your-hindsight-api-key>

# Hindsight API key, used only when no key is stored and HINDSIGHT_API_KEY is empty.
# HINDSIGHT_API_TOKEN=<your-hindsight-api-token>

# RAGFlow base URL, used only when ragflow.url is empty.
RAGFLOW_URL=<your-ragflow-url>

# RAGFlow API key, used when no ragflow key is stored.
# RAGFLOW_API_KEY=<your-ragflow-api-key>

# Desk gateway base URL.
DESK_GATEWAY_URL=<your-desk-gateway-url>

# Desk gateway seat name; a name that does not match [a-z][a-z0-9-]{0,31} is ignored.
DESK_GATEWAY_SEAT=<your-desk-gateway-seat>

# Desk gateway token, used when no gateway token is stored.
# DESK_GATEWAY_TOKEN=<your-desk-gateway-token>

# Timeout of one desk gateway request in milliseconds; a value outside the range is ignored.
DESK_GATEWAY_TIMEOUT_MS=<your-desk-gateway-timeout-ms>

# OpenRouter key for Jev decisions, used when no openrouter key is stored.
# ULTRATHINK_OPENROUTER_KEY=<your-openrouter-key>

# Vercel AI Gateway key for Jev decisions, used when no stored key is found.
# AI_GATEWAY_API_KEY=<your-ai-gateway-api-key>

# Decisions endpoint.
ULTRATHINK_DECISIONS_URL=<your-decisions-url>

# Absolute path of an agent-swarm checkout, required for swarm lanes.
ULTRATHINK_SWARM_ROOT=<your-swarm-root>

# Alias of ULTRATHINK_SWARM_ROOT, read only when ULTRATHINK_SWARM_ROOT is empty.
SWARM_ROOT=<your-swarm-root-alias>

# Most swarm lanes alive at once across all commands, and the most briefs one command starts.
ULTRATHINK_SWARM_MAX_LANES=<your-swarm-max-lanes>

# Run cap in seconds, passed through unchanged to each swarm lane.
SWARM_AUTONOMOUS_RUN_CAP_S=<your-swarm-autonomous-run-cap-s>

# Seconds between SIGTERM and SIGKILL when a lane is stopped; a number of 0 or more, else 15.
SWARM_AUTONOMOUS_RUN_GRACE_S=<your-swarm-autonomous-run-grace-s>

# Path of the credential store.
ULTRATHINK_MCP_STORE=<your-mcp-store>

# OAuth callback URL for ultrathink-mcp auth login; the --redirect flag wins over it.
ULTRATHINK_OAUTH_REDIRECT=<your-oauth-redirect>

# Set to 1 to receive the OAuth callback through tailscale serve on a remote session.
ULTRATHINK_OAUTH_TAILSCALE=<your-oauth-tailscale>

# Set to 1 to write ultrathink log lines and one line per Jev decision to stderr.
ULTRATHINK_DEBUG=<your-debug>

# Set to 1 so ultrathink-mcp serve writes relay log lines to stderr.
ULTRATHINK_MCP_DEBUG=<your-mcp-debug>

# File descriptor that receives one JSON progress line per event; 3 or higher, else ignored.
ULTRATHINK_PROGRESS_FD=<your-progress-fd>

# Forces the detected host; an unknown value is ignored.
ULTRATHINK_HOST=<your-host>

# Directory for control state and session records instead of the host default.
ULTRATHINK_STATE_DIR=<your-state-dir>

# Directory holding config.json for the Cursor pstack hook and the doctor pstack section only.
ULTRATHINK_CONFIG_DIR=<your-config-dir>

# Absolute Cursor directory for the pstack hook; it wins over pstack.cursorDir.
ULTRATHINK_PSTACK_CURSOR_DIR=<your-pstack-cursor-dir>

# Shared Agent Skills directory that scripts/setup.ts installs into.
ULTRATHINK_AGENT_SKILLS_DIR=<your-agent-skills-dir>

# Base of the user config, the credential store and some host state directories.
XDG_CONFIG_HOME=<your-xdg-config-home>

# Claude user config directory, also the Claude Code state directory.
CLAUDE_CONFIG_DIR=<your-claude-config-dir>

# Grok home directory, also the Grok Build state directory when GROK_PLUGIN_DATA is unset.
GROK_HOME=<your-grok-home>

# Grok Build state directory.
GROK_PLUGIN_DATA=<your-grok-plugin-data>

# Hermes home directory, also the Hermes state directory.
HERMES_HOME=<your-hermes-home>

# Omp agent directory, also the Omp state directory.
PI_CODING_AGENT_DIR=<your-pi-coding-agent-dir>

# Prime Agent directory, also the Prime Agent state directory.
PRIME_AGENT_CODING_AGENT_DIR=<your-prime-agent-coding-agent-dir>

# Hermes only: longest time in seconds one plan may run.
ULTRATHINK_HERMES_TIMEOUT=<your-hermes-timeout>

# Cursor only: longest wait for one plan in milliseconds.
ULTRATHINK_CURSOR_BUDGET_MS=<your-cursor-budget-ms>

# Log level of the stdio tool host: info, warn or error, compared without case; anything else means warn.
ULTRATHINK_LOG_LEVEL=<your-log-level>

# Public origin of the hosted service: https, or http for localhost and 127.0.0.1; scheme, host and port only.
ULTRATHINK_PUBLIC_ORIGIN=<your-public-origin>

# Argon2 or bcrypt hash of the owner password, as Bun.password.hash makes it.
# ULTRATHINK_OWNER_PASSWORD_HASH=<your-owner-password-hash>

# Session signing secret of at least 32 characters.
# ULTRATHINK_SESSION_SECRET=<your-session-secret>

# Comma list of up to 4 earlier session secrets still accepted, so a rotation signs nobody out.
# ULTRATHINK_SESSION_SECRET_PREVIOUS=<your-session-secret-previous>

# Connector key of at least 32 characters, for the MCP connector route.
# ULTRATHINK_CONNECTOR_KEY=<your-connector-key>

# Listen port of the hosted service.
ULTRATHINK_PORT=<your-port>

# Comma list of bare origins (https or http) allowed to call the service from a browser.
ULTRATHINK_ALLOWED_ORIGINS=<your-allowed-origins>

# Comma list of bare https origins accepted as OAuth redirect targets.
ULTRATHINK_OAUTH_REDIRECT_ORIGINS=<your-oauth-redirect-origins>

# Claude model id of the hosted planner: 1 to 80 characters from letters, digits, dot, underscore, colon and dash.
ULTRATHINK_PLANNING_MODEL=<your-planning-model>

# Whether a failed Claude call fails over to Grok.
ULTRATHINK_PLANNING_FALLBACK=<your-planning-fallback>

# Set to 1 to let the service plan on the server.
ULTRATHINK_SERVER_PLANNING=<your-server-planning>

# Set to 1 to run without TLS; for development and local smoke tests only.
ULTRATHINK_PLAINTEXT_LOOPBACK=<your-plaintext-loopback>

# Longest accepted prompt in characters; 0 means no limit, otherwise at least 1.
ULTRATHINK_MAX_INPUT_CHARS=<your-max-input-chars>

# Longest accepted answer in characters.
ULTRATHINK_MAX_ANSWER_CHARS=<your-max-answer-chars>

# Token ceiling of one run; 0 means unlimited, otherwise at least 1.
ULTRATHINK_RUN_TOKEN_CEILING=<your-run-token-ceiling>

# Token ceiling per day; 0 means unlimited, otherwise at least 1.
ULTRATHINK_DAILY_TOKEN_CEILING=<your-daily-token-ceiling>

# Most claude children in flight at once.
ULTRATHINK_PLAN_CONCURRENCY=<your-plan-concurrency>

# Most plans running at once.
ULTRATHINK_MAX_CONCURRENT_PLANS=<your-max-concurrent-plans>

# Timeout of one model call in milliseconds; 0 means unlimited, otherwise 5000 or more.
ULTRATHINK_MODEL_TIMEOUT_MS=<your-model-timeout-ms>

# Timeout of one plan in milliseconds; 0 means unlimited, otherwise 30000 or more.
ULTRATHINK_PLAN_TIMEOUT_MS=<your-plan-timeout-ms>

# Output token cap of one model call; 0 means no configured cap, otherwise 256 or more.
ULTRATHINK_MODEL_MAX_OUTPUT_TOKENS=<your-model-max-output-tokens>

# Upstream failures within the window that open the breaker; 0 disables it.
ULTRATHINK_BREAKER_FAILURES=<your-breaker-failures>

# Window in which upstream failures are counted, in milliseconds.
ULTRATHINK_BREAKER_WINDOW_MS=<your-breaker-window-ms>

# How long the breaker stays open before a trial request, in milliseconds.
ULTRATHINK_BREAKER_OPEN_MS=<your-breaker-open-ms>

# Most concurrent HTTP requests the router admits.
ULTRATHINK_MAX_INFLIGHT=<your-max-inflight>

# Percent of in-flight capacity kept free for the owner.
ULTRATHINK_PRIORITY_RESERVE_PCT=<your-priority-reserve-pct>

# Over-budget requests that may wait per priority class; 0 refuses at once.
ULTRATHINK_FAIR_QUEUE_DEPTH=<your-fair-queue-depth>

# Longest wait in the fair-share queue, in milliseconds.
ULTRATHINK_FAIR_QUEUE_WAIT_MS=<your-fair-queue-wait-ms>

# Lowest percentage the adaptive quota may shrink the request windows to.
ULTRATHINK_ADAPTIVE_QUOTA_MIN_PCT=<your-adaptive-quota-min-pct>

# Event-loop lag above which the adaptive quota shrinks, in milliseconds.
ULTRATHINK_LAG_TARGET_MS=<your-lag-target-ms>

# Requests per second one replica is assumed to serve.
ULTRATHINK_REPLICA_CAPACITY_RPS=<your-replica-capacity-rps>

# Failures per minute from one IP that start an abuse penalty.
ULTRATHINK_ABUSE_FAILURES_PER_MINUTE=<your-abuse-failures-per-minute>

# Length of an IP's first abuse penalty block, in seconds.
ULTRATHINK_PENALTY_BASE_SEC=<your-penalty-base-sec>

# Longest abuse penalty block in seconds; never below the base block.
ULTRATHINK_PENALTY_MAX_SEC=<your-penalty-max-sec>

# Wait after shutdown begins so in-flight work can finish, in milliseconds.
ULTRATHINK_DRAIN_MS=<your-drain-ms>

# Days of finished jobs, sessions and journals to keep; 0 disables the sweep.
ULTRATHINK_RETENTION_DAYS=<your-retention-days>

# Set to 0 to stop writing the append-only audit log.
ULTRATHINK_AUDIT_LOG=<your-audit-log>

# Audit records between anchor records of the hash chain.
ULTRATHINK_AUDIT_ANCHOR_EVERY=<your-audit-anchor-every>

# Size at which the audit log rolls to a new segment, in bytes.
ULTRATHINK_AUDIT_SEGMENT_BYTES=<your-audit-segment-bytes>

# Days of audit segments to keep; 0 keeps them all.
ULTRATHINK_AUDIT_RETENTION_DAYS=<your-audit-retention-days>

# Interval of the audit integrity watch, in milliseconds.
ULTRATHINK_AUDIT_WATCH_MS=<your-audit-watch-ms>

# Envelopes each audit sink may hold waiting before the oldest is dropped.
ULTRATHINK_AUDIT_SINK_QUEUE=<your-audit-sink-queue>

# JSON array of anomaly rules; unset means the built-in rules.
ULTRATHINK_AUDIT_RULES=<your-audit-rules>

# HTTP audit sink endpoint: https, or http to 127.0.0.1 or localhost.
ULTRATHINK_AUDIT_HTTP_URL=<your-audit-http-url>

# Token for the HTTP audit sink: at least 16 printable ASCII characters.
# ULTRATHINK_AUDIT_HTTP_TOKEN=<your-audit-http-token>

# Syslog audit sink as host:port, with a port from 1 to 65535.
ULTRATHINK_AUDIT_SYSLOG=<your-audit-syslog>

# Kafka REST proxy endpoint of the audit sink; set together with the topic.
ULTRATHINK_AUDIT_KAFKA_REST_URL=<your-audit-kafka-rest-url>

# Kafka topic of the audit sink; set together with the REST URL.
ULTRATHINK_AUDIT_KAFKA_TOPIC=<your-audit-kafka-topic>

# OTLP/JSON trace collector base URL: https, or http to loopback.
ULTRATHINK_OTLP_ENDPOINT=<your-otlp-endpoint>

# Absolute path of the server certificate; set with the key and the client CA, or none.
ULTRATHINK_TLS_CERT=<your-tls-cert>

# Absolute path of the server certificate key; set with the certificate and the client CA, or none.
ULTRATHINK_TLS_KEY=<your-tls-key>

# Absolute path of the CA that signs client certificates; set with the certificate and the key, or none.
ULTRATHINK_TLS_CLIENT_CA=<your-tls-client-ca>

# SPIFFE trust domain that peer certificate identities must belong to.
ULTRATHINK_SPIFFE_TRUST_DOMAIN=<your-spiffe-trust-domain>

# Set to 1 to arm fault injection at the upstream seam; needs the staging environment and a plan.
ULTRATHINK_CHAOS=<your-chaos>

# Must be staging whenever chaos is enabled.
ULTRATHINK_CHAOS_ENV=<your-chaos-env>

# Absolute path of the fault plan; required whenever chaos is enabled.
ULTRATHINK_CHAOS_PLAN=<your-chaos-plan>
